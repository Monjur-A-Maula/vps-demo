# App ports
PORT=4999
FRONTEND_PORT=3999
BACKEND_PORT=4999

# Database credentials (MySQL Docker container on host port 3307)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=your_vps_username
DB_USER=your_vps_username
DB_PASSWORD=your_mysql_password

# Frontend path on Nginx
NEXT_PUBLIC_BASE_PATH=/your_vps_username/vps-demo
